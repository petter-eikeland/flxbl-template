				{
					"package": "platform-base",
					"versionNumber": "0.1.0.LATEST"
				},
				{
					"package": "package",
					"versionNumber": "0.1.0.LATEST"
				}
			]
		},
		{
			"path": "global/src-env-specific",
			"package": "src-env-specific",
			"versionNumber": "0.1.0.0",
